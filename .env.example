# Supabase 프로젝트 설정 (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API 키 암호화용 32바이트 키 (base64). 생성: openssl rand -base64 32
ENCRYPTION_KEY=

# 선생님 자가 가입(새 공부방 생성) 허용 여부. 운영 중에는 false 권장.
TEACHER_SIGNUP_ENABLED=true

# cron 처리 엔드포인트 보호용 비밀값 (Phase 4). 생성: openssl rand -hex 32
CRON_SECRET=
